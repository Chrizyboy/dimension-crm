{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dimension CRM",
  "version": "../package.json",
  "identifier": "ch.dimension-solaire.crm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dimension CRM",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co http://127.0.0.1:54321 ws://127.0.0.1:54321 https://*.ingest.de.sentry.io; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Dimension Solaire",
    "category": "Business",
    "shortDescription": "CRM für Solar, Energie und Projekte",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": { "language": ["de-DE", "fr-FR"] },
      "nsis": { "languages": ["German", "French"], "displayLanguageSelector": true }
    }
  }
}
