# Kopiere diese Datei nach .env.local und trage die Werte ein.
# Nur öffentliche Werte gehören hierher (VITE_ = im Programm sichtbar).
# Geheimnisse (Claude-API, AbaNinja, Microsoft, SMS …) liegen NUR in den Supabase-Secrets der Edge Functions.

# Adresse und öffentlicher Schlüssel von Supabase (lokal: Ausgabe von "npm run db:start")
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Fehlerüberwachung (Sentry, Rechenzentrum EU/Frankfurt). Leer lassen = aus.
# Der DSN ist kein Geheimnis (er erlaubt nur das Melden von Fehlern), gehört aber trotzdem nicht ins Git.
VITE_SENTRY_DSN=

# NUR für das Import-Skript (npm run import:vorlage), nie mit VITE_ und nie in der App:
# der service_role-Schlüssel umgeht alle Zugriffsregeln. Lokal zeigt ihn «npx supabase status».
# Nicht in .env.local speichern, sondern nur beim Aufruf setzen.
# SUPABASE_SERVICE_ROLE_KEY=

# Anmeldung mit Microsoft (Phase 4). Nur für die lokale Supabase (supabase/config.toml), nie mit VITE_.
# Im echten Projekt trägt man diese Werte im Supabase-Dashboard unter Authentication > Providers > Azure ein.
# Anleitung: docs/anmeldung.md. Lokal leer lassen = Microsoft-Knopf erscheint nicht, Code per E-Mail geht trotzdem.
# SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/<Verzeichnis-ID>/v2.0

# Eturnity-Webhook (Phase 7). Nur als Supabase-Secret setzen, nie mit VITE_ und nie in die App:
#   npx supabase secrets set ETURNITY_WEBHOOK_SECRET=<langer Zufallswert>
# Eturnity bzw. Zapier ruft dann https://<projekt>.supabase.co/functions/v1/eturnity-eingang?token=<Wert> auf.
# Anleitung: docs/eturnity.md
# ETURNITY_WEBHOOK_SECRET=

# Integrationen (Phase 8): Microsoft 365, AbaNinja, ASPSMS, Zeitplan. NUR als Supabase-Secret setzen,
# nie mit VITE_ und nie in die App. Anleitung Schritt für Schritt: docs/integrationen.md
#   npx supabase secrets set NAME=wert
# MS_CLIENT_ID=            Application (client) ID der App-Registrierung in Entra ID
# MS_TENANT_ID=            Directory (tenant) ID
# MS_CLIENT_SECRET=        Client Secret (läuft ab, im Kalender eintragen)
# VERBINDUNG_SCHLUESSEL=   Verschlüsselt die Microsoft-Verbindungen: openssl rand -base64 32
# APP_URL=                 Adresse der Web-App (dorthin führt Microsoft nach der Anmeldung zurück)
# ABANINJA_TOKEN=          API-Token aus AbaNinja
# ABANINJA_KONTO=          Account-UUID aus AbaNinja
# ASPSMS_USERKEY=          ASPSMS Userkey
# ASPSMS_PASSWORT=         ASPSMS API-Passwort
# ZEITPLAN_SCHLUESSEL=     Schützt den Aufruf der Hintergrund-Jobs: openssl rand -hex 24
# Nur für Tests mit Ersatz-Servern (npm run integrationen:pruefen), im Betrieb leer lassen:
# MS_LOGIN_URL=  MS_GRAPH_URL=  MS_RUECKRUF_URL=  ABANINJA_URL=  ASPSMS_URL=
# Dazu einmal im SQL Editor (Vault): crm_funktionen_url und crm_zeitplan_schluessel, siehe docs/integrationen.md
