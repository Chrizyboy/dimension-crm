# Kopiere diese Datei nach .env.local und trage die Werte ein.
# Nur öffentliche Werte gehören hierher (VITE_ = im Programm sichtbar).
# Geheimnisse (Claude-API, AbaNinja, Microsoft, SMS …) liegen NUR in den Supabase-Secrets der Edge Functions.

# Adresse und öffentlicher Schlüssel von Supabase (lokal: Ausgabe von "npm run db:start")
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
